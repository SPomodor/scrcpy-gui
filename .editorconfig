root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csproj,xaml,ps1,cmd,bat}]
end_of_line = crlf

[*.{md,json,yml,yaml}]
end_of_line = lf

[licenses/**]
trim_trailing_whitespace = false
