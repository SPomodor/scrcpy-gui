<Window x:Class="AndroidDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="#101317">
    <Grid.Resources>
      <Style x:Key="QuickButton" TargetType="Button">
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="16"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="6"/>
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
    <Grid x:Name="Viewport" SizeChanged="ViewportChanged">
      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="290" Margin="20">
        <FontIcon Glyph="&#xE8EA;" FontSize="40" Foreground="#77B8FA"/>
        <TextBlock x:Name="EmptyTitle" Text="Подключите телефон" FontSize="20" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="EmptyHint" Text="Включите USB-отладку и разрешите подключение на телефоне. Выбрать устройство можно кнопкой справа." Foreground="#A4AEBB" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="5,4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="2">
        <Button x:Name="DeviceButton" Style="{StaticResource QuickButton}" Content="&#xE8EA;" AutomationProperties.Name="Выбрать телефон" ToolTipService.ToolTip="Выбрать телефон" Click="DeviceClick"/>
        <Button x:Name="ConnectButton" Style="{StaticResource QuickButton}" Content="&#xE8D4;" AutomationProperties.Name="Подключить или отключить" ToolTipService.ToolTip="Подключить / отключить" Click="ConnectClick"/>
        <Border Height="1" Margin="5,5" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <StackPanel x:Name="PhoneControls" Spacing="2">
          <Button Style="{StaticResource QuickButton}" Content="&#xE72B;" AutomationProperties.Name="Назад" ToolTipService.ToolTip="Назад" Tag="4" Click="KeyClick"/>
          <Button Style="{StaticResource QuickButton}" Content="&#xE80F;" AutomationProperties.Name="Домой" ToolTipService.ToolTip="Домой" Tag="3" Click="KeyClick"/>
          <Button Style="{StaticResource QuickButton}" Content="&#xE7F4;" AutomationProperties.Name="Недавние приложения" ToolTipService.ToolTip="Недавние приложения" Tag="187" Click="KeyClick"/>
          <Border Height="1" Margin="5,5" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
          <Button Style="{StaticResource QuickButton}" Content="&#xE995;" AutomationProperties.Name="Громче" ToolTipService.ToolTip="Громче" Tag="24" Click="KeyClick"/>
          <Button Style="{StaticResource QuickButton}" Content="&#xE994;" AutomationProperties.Name="Тише" ToolTipService.ToolTip="Тише" Tag="25" Click="KeyClick"/>
          <Button Style="{StaticResource QuickButton}" Content="&#xE708;" AutomationProperties.Name="Питание" ToolTipService.ToolTip="Блокировка / пробуждение" Tag="26" Click="KeyClick"/>
          <Border Height="1" Margin="5,5" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
          <Button Style="{StaticResource QuickButton}" Content="&#xE722;" AutomationProperties.Name="Скриншот" ToolTipService.ToolTip="Скриншот" Click="ScreenshotClick"/>
        </StackPanel>
        <Button x:Name="RecordButton" Style="{StaticResource QuickButton}" Foreground="#F06C75" Content="&#xE7C8;" AutomationProperties.Name="Начать запись" ToolTipService.ToolTip="Начать запись" Click="RecordClick"/>
        <TextBlock x:Name="RecordTime" Visibility="Collapsed" FontSize="9" Foreground="#F06C75" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="2">
        <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" Margin="0,4"/>
        <Button Style="{StaticResource QuickButton}" Content="&#xE8B9;" AutomationProperties.Name="По размеру телефона" ToolTipService.ToolTip="Подогнать окно по телефону" Click="FitClick"/>
        <Button x:Name="SettingsButton" Style="{StaticResource QuickButton}" Content="&#xE712;" AutomationProperties.Name="Настройки" ToolTipService.ToolTip="Настройки" Click="SettingsClick"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
